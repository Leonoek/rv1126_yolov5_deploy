source /etc/profile 
case "$1" in 
  start) 
	echo "start ispserver "
	ispserver &
        ;; 
  stop) 
        echo "stop ispserver" 
        ;; 
  reload|force-reload) 
        echo "Reloading ispserver" 
        "$0" reload 
        ;; 
  restart) 
        "$0" stop 
        sleep 1 # Prevent race condition: ensure QDesktop stops before 
start. 
        "$0" start 
        ;; 
  *) 
        echo "Usage: $0 {start|stop|restart|reload|force-reload}" 
esac 
exit 0
